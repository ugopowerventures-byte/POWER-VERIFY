# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Verification Provider Credentials
# Veripine API Credentials (handles NIN & BVN Verification, NIN Phone Search, BVN Retrieval with Phone, Personalization Tracking, Demographic Verification, NIN Modifications)
VERIPINE_SECRET_KEY=""
VERIPINE_API_KEY=""
VERIPINE_BASE_URL="https://veripine.com/api"

# Ninja API Credentials (handles NIN, BVN, Identity Cross-Lookup, Driving Licence, BVN by CRM)
NINJA_PUBLIC_KEY=""
NINJA_SECRET_KEY=""
NINJA_BASE_URL="https://api.ninja.boucloud.io"

# Legacy / Unified Provider fallback (e.g., Prembly / IdentityPass, QoreID, Dojah)
VERIFICATION_PROVIDER_KEY=""
VERIFICATION_PROVIDER_SECRET=""
VERIFICATION_PROVIDER_URL=""

# Platform Settings
JWT_SECRET=""
SUPPORT_WHATSAPP="+2348000000000"
SUPPORT_EMAIL="contact@ugopawaverify.com.ng"

# Supabase Credentials (Database & Storage)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Paystack Payment Gateway Credentials (LIVE MODE)
# PAYSTACK_SECRET_KEY: Used server-side ONLY for transaction initialize/verify and webhook HMAC. NEVER expose to client.
PAYSTACK_SECRET_KEY="sk_live_your-paystack-live-secret-key"
# VITE_PAYSTACK_PUBLIC_KEY: Client-side public key for Paystack checkout. Safe for browser.
VITE_PAYSTACK_PUBLIC_KEY="pk_live_your-paystack-live-public-key"

# Sendchamp SMS / OTP Gateway Credentials
# SENDCHAMP_API_KEY: Server-side secret key for live SMS OTP delivery. NEVER expose to client.
SENDCHAMP_BASE_URL="https://api.sendchamp.com/api/v1"
SENDCHAMP_API_KEY=""


